{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-gateway.local/schemas/chat-request.v1.json",
  "title": "POST /api/v1/chat request body (v1)",
  "description": "Mirrors gateway-api ChatRequest.java. Exactly one of messages or prompt; settings only with messages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskClass"],
  "properties": {
    "taskClass": { "enum": ["SUMMARY", "EXTRACTION", "REASONING", "CLASSIFICATION", "EMBEDDING"] },
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["SYSTEM", "USER", "ASSISTANT"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 32000 }
        }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "topP": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 32000 },
        "stopSequences": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "seed": { "type": "integer" }
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false, "required": ["promptId"],
      "properties": {
        "promptId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "variables": {
          "type": "object", "maxProperties": 32,
          "propertyNames": { "minLength": 1, "maxLength": 64 },
          "additionalProperties": { "type": "string", "maxLength": 32000 }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["messages"], "not": { "required": ["prompt"] } },
    { "required": ["prompt"], "not": { "anyOf": [ { "required": ["messages"] }, { "required": ["settings"] } ] } }
  ]
}
