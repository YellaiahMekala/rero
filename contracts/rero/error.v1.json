{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.local/rero/error.v1.json",
  "title": "Error body for every non-2xx RERO response (v1)",
  "description": "Contract C conventions. The message is safe text and never echoes submitted values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 64 },
    "message": { "type": "string", "maxLength": 300 }
  }
}
